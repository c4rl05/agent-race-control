{
  "name": "agent-race-control",
  "productName": "Agent Race Control",
  "version": "0.1.8",
  "description": "Agent Race Control — a session-aware terminal cockpit for Claude Code on native Windows, with macOS in progress",
  "author": "HelloEnjoy <carlos@helloenjoy.com>",
  "license": "MIT",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "npm run fix-pty-perms && electron-vite dev",
    "build": "electron-vite build",
    "preview": "npm run fix-pty-perms && electron-vite preview",
    "typecheck": "tsc --noEmit && svelte-check --tsconfig ./src/renderer/tsconfig.json",
    "test": "vitest run",
    "test:mutation": "stryker run",
    "format": "prettier --write .",
    "fix-pty-perms": "node scripts/fix-pty-perms.mjs",
    "screenshots": "npm run fix-pty-perms && electron-vite build && node scripts/screenshot.mjs",
    "dist": "npm run fix-pty-perms && electron-vite build && electron-builder",
    "dist:dir": "npm run fix-pty-perms && electron-vite build && electron-builder --dir"
  },
  "devDependencies": {
